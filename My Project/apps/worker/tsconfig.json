{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "verbatimModuleSyntax": false,
    "allowImportingTsExtensions": false,
    "paths": {
      "@flowforge/shared": ["../../packages/shared/src/index.ts"],
      "@flowforge/db": ["../../packages/db/src/index.ts"],
      "@flowforge/nodes-sdk": ["../../packages/nodes-sdk/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
