# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://flowforge:flowforge@localhost:5432/flowforge?schema=public"
DIRECT_URL="postgresql://flowforge:flowforge@localhost:5432/flowforge?schema=public"

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Auth (generate with: openssl rand -base64 32) ───────────────────────────
AUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="http://localhost:3000"

# ─── OAuth Providers ─────────────────────────────────────────────────────────
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ─── Email (Mailhog for dev) ──────────────────────────────────────────────────
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@flowforge.dev"

# ─── Storage (MinIO for dev) ──────────────────────────────────────────────────
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="flowforge"
S3_REGION="us-east-1"

# ─── Encryption (generate with: openssl rand -hex 32) ────────────────────────
MASTER_ENCRYPTION_KEY="change-me-32-bytes-hex-encoded-00"

# ─── API ──────────────────────────────────────────────────────────────────────
API_URL="http://localhost:3001"
API_SECRET="change-me-internal-api-secret"

# ─── LLM Providers (optional — users add their own via UI) ────────────────────
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_AI_API_KEY=""
GROQ_API_KEY=""
MISTRAL_API_KEY=""

# ─── Webhook Gateway ──────────────────────────────────────────────────────────
WEBHOOK_BASE_URL="http://localhost:3001"

# ─── Feature Flags ────────────────────────────────────────────────────────────
ENABLE_COLLABORATION="true"
ENABLE_BILLING="false"
