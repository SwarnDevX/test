# ─── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=codecrafter
POSTGRES_USER=cc_user
POSTGRES_PASSWORD=change_me_postgres

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_redis

# ─── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_USER=cc_rabbit
RABBITMQ_PASSWORD=change_me_rabbit

# ─── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ACCESS_KEY=cc_minio_access
MINIO_SECRET_KEY=change_me_minio_secret_must_be_8_chars

# ─── JWT ───────────────────────────────────────────────────────────────────────
# Must be >= 32 characters for HS256
JWT_SECRET=change_me_in_production_at_least_32_chars_long_random_string
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# ─── OAuth2 ────────────────────────────────────────────────────────────────────
# Create apps at:
#   Google: https://console.cloud.google.com/apis/credentials
#   GitHub: https://github.com/settings/developers
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# ─── Next.js / NextAuth ────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change_me_nextauth_secret_32_chars_min
NEXT_PUBLIC_API_URL=http://localhost:8080
# Internal backend URL (server-side Next.js → Spring Boot, used in authOptions)
BACKEND_URL=http://api:8080

# ─── App ───────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Stripe (test mode — Phase 8) ──────────────────────────────────────────────
STRIPE_PUBLIC_KEY=pk_test_placeholder
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
