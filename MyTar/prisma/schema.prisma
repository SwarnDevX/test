// This is your Prisma schema file
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  FREE
  PRO
  BUSINESS
}

enum AssetType {
  BACKGROUND
  COPY
  LAYOUT
  EXPORT
  LOGO
  UPLOAD
}

enum AssetStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

enum ProjectStatus {
  DRAFT
  EXPORTED
}

model User {
  id                     String    @id @default(cuid())
  email                  String    @unique
  passwordHash           String?
  name                   String?
  avatarUrl              String?
  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?
  plan                   Plan      @default(FREE)
  creditBalance          Int       @default(10)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  projects       Project[]
  brandKits      BrandKit[]
  generatedAssets GeneratedAsset[]
  accounts       Account[]
  sessions       Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id           String        @id @default(cuid())
  userId       String
  name         String
  description  String?
  canvasState  Json          @default("{}")
  thumbnailUrl String?
  width        Int           @default(1200)
  height       Int           @default(628)
  status       ProjectStatus @default(DRAFT)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  generatedAssets GeneratedAsset[]
}

model BrandKit {
  id        String   @id @default(cuid())
  userId    String
  name      String
  colors    String[]
  fonts     Json     @default("{}")
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GeneratedAsset {
  id         String      @id @default(cuid())
  userId     String
  projectId  String?
  type       AssetType
  prompt     String?
  resultUrl  String?
  creditCost Int         @default(1)
  jobId      String?
  status     AssetStatus @default(PENDING)
  metadata   Json        @default("{}")
  createdAt  DateTime    @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

