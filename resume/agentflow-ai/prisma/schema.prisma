generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ChatSession {
  id        String   @id @default(cuid())
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages  ChatMessage[]
  traces    AgentTrace[]
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  role      String
  content   String
  metadata  String?
  createdAt DateTime    @default(now())
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model Workflow {
  id          String        @id @default(cuid())
  name        String
  description String?
  definition  String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  runs        WorkflowRun[]
}

model WorkflowRun {
  id         String            @id @default(cuid())
  workflowId String
  status     String            @default("pending")
  input      String?
  output     String?
  steps      WorkflowRunStep[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  workflow   Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
}

model WorkflowRunStep {
  id          String      @id @default(cuid())
  runId       String
  stepId      String
  stepName    String
  status      String      @default("pending")
  input       String?
  output      String?
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  run         WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)
}

model KbDocument {
  id         String    @id @default(cuid())
  name       String
  type       String
  size       Int
  status     String    @default("processing")
  chunkCount Int       @default(0)
  createdAt  DateTime  @default(now())
  chunks     KbChunk[]
}

model KbChunk {
  id         String     @id @default(cuid())
  docId      String
  content    String
  embedding  String?
  metadata   String?
  chunkIndex Int
  doc        KbDocument @relation(fields: [docId], references: [id], onDelete: Cascade)
}

model AgentTrace {
  id          String           @id @default(cuid())
  sessionId   String?
  traceType   String           @default("chat")
  status      String           @default("running")
  input       String
  output      String?
  totalTokens Int              @default(0)
  totalCost   Float            @default(0)
  latencyMs   Int              @default(0)
  steps       AgentTraceStep[]
  createdAt   DateTime         @default(now())
  session     ChatSession?     @relation(fields: [sessionId], references: [id])
}

model AgentTraceStep {
  id         String     @id @default(cuid())
  traceId    String
  agent      String
  stepType   String
  input      String
  output     String?
  tokensUsed Int        @default(0)
  latencyMs  Int        @default(0)
  error      String?
  createdAt  DateTime   @default(now())
  trace      AgentTrace @relation(fields: [traceId], references: [id], onDelete: Cascade)
}

model ObsEvent {
  id        String   @id @default(cuid())
  eventType String
  agent     String?
  model     String?
  tokens    Int?
  latencyMs Int?
  cost      Float?
  metadata  String?
  createdAt DateTime @default(now())
}
