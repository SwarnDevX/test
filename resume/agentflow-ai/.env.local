# AgentFlow AI — Environment Variables
# Without OPENAI_API_KEY the app runs in realistic DEMO MODE

OPENAI_API_KEY=

# SQLite (default, no server needed). Switch to postgres://... for production.
DATABASE_URL="file:./data/agentflow.db"

# Optional Redis for persistent memory cache. Falls back to in-memory if unset.
REDIS_URL=

# App URL (used by Socket.IO CORS)
NEXT_PUBLIC_APP_URL=http://localhost:3000

PORT=3000
