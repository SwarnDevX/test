{
  "name": "@agentbay/x402",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./server": {
      "import": "./dist/server/index.js",
      "types": "./dist/server/index.d.ts"
    },
    "./client": {
      "import": "./dist/client/index.js",
      "types": "./dist/client/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts src/server/index.ts src/client/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts src/server/index.ts src/client/index.ts --format esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@agentbay/shared": "workspace:*",
    "hono": "^4.12.23",
    "viem": "^2.31.3",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "tsup": "^8.5.1"
  }
}
