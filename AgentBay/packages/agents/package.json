{
  "name": "@agentbay/agents",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@agentbay/shared": "workspace:*",
    "@agentbay/x402": "workspace:*",
    "@ai-sdk/anthropic": "^1.2.12",
    "@modelcontextprotocol/sdk": "^1.12.2",
    "ai": "^4.3.16",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "tsup": "^8.5.1"
  }
}
